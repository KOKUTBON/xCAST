# Runtime data
DATA_DIR=data

# API security
API_KEY=

# Upload hardening
UPLOAD_MAX_BYTES=31457280

# Queue config (must align with worker)
QUEUE_MODE=dir
QUEUE_DIR=data/queue
QUEUE_FILE=data/queue/queue.jsonl
QUEUE_REDIS_URL=redis://localhost:6379/0
QUEUE_REDIS_KEY=podcastify:jobs

# Logging
LOG_FORMAT=plain

# Storage backend (local | s3)
STORAGE_BACKEND=local
# STORAGE_S3_BUCKET=my-podcast-bucket
# STORAGE_S3_PREFIX=artifacts
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

