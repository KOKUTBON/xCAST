# ==============================================================================
# xCAST Environment Configuration Template
# ==============================================================================
# Copy this template to configure your local or container deployment:
#   cp .env.example .env
# Or configure services individually in services/api/.env and services/worker/.env
#
# NOTE: Never commit sensitive credentials to version control.
# ==============================================================================

# --- Runtime Data ---
DATA_DIR=data

# --- API Security ---
# Optional shared token for securing API endpoints.
# When set, requests require 'X-API-Key: <key>' or 'Authorization: Bearer <key>'.
API_KEY=

# Upload size limit in bytes (default: 30 MB = 31457280)
UPLOAD_MAX_BYTES=31457280

# --- Task Queue ---
# Mode: 'dir' (local directory polling), 'file' (JSONL file), or 'redis' (distributed sorted set)
QUEUE_MODE=dir
QUEUE_DIR=data/queue
QUEUE_FILE=data/queue/queue.jsonl
QUEUE_REDIS_URL=redis://localhost:6379/0
QUEUE_REDIS_KEY=podcastify:jobs
QUEUE_POLL_INTERVAL_S=2.0

# --- Worker Reliability & Concurrency ---
MAX_JOB_ATTEMPTS=3
RETRY_BACKOFF_S=1.5
WORKER_MAX_CONCURRENT=1
JOB_CLAIM_STALE_S=3600
WRITE_RETRIES=4
WRITE_BACKOFF_S=0.2

# --- LLM Script Generation ---
# Provider: 'ollama' (local) or 'openrouter' (cloud)
SCRIPT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:instruct
OLLAMA_TIMEOUT_S=600
OLLAMA_NUM_PREDICT=480
MAX_CONTEXT_CHARS=4000

# OpenRouter configuration (required only when SCRIPT_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2.1
OPENROUTER_TIMEOUT_S=40

# --- Retrieval / RAG (Optional) ---
# Embeddings: 'none' or 'ollama'
EMBEDDING_PROVIDER=none
VECTOR_STORE_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text

# --- Speech Synthesis & Audio Mastering ---
# Set to 'true' to enable audio generation (requires FFmpeg)
ENABLE_TTS=false
ENABLE_AUDIO=false
TTS_PROVIDER=pyttsx3
AUDIO_FORMAT=mp3
AUDIO_TARGET_DBFS=-16

# Voice provider options
# MiniMax TTS (required only when TTS_PROVIDER=minimax)
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=

# --- Logging & Observability ---
LOG_FORMAT=plain
METRICS_ENABLED=false
METRICS_PORT=9000

# --- Storage Backend ---
# Storage: 'local' (filesystem) or 's3' (S3, MinIO, Cloudflare R2)
STORAGE_BACKEND=local
# STORAGE_S3_BUCKET=my-podcast-bucket
# STORAGE_S3_PREFIX=artifacts
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_STAGING_DIR=data/staging
